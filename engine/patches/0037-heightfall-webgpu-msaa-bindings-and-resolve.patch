+	// including for sliced views. Do not add WGTexture::base_layer/base_mipmap.
+	WGPUTextureViewDescriptor src_view_desc = {};
+	src_view_desc.format = src->format;
+	src_view_desc.dimension = WGPUTextureViewDimension_2D;
+	src_view_desc.baseMipLevel = p_src_mipmap;
+	src_view_desc.mipLevelCount = 1;
+	src_view_desc.baseArrayLayer = p_src_layer;
+	src_view_desc.arrayLayerCount = 1;
+	src_view_desc.aspect = WGPUTextureAspect_All;
+	WGPUTextureViewDescriptor dst_view_desc = src_view_desc;
+	dst_view_desc.baseMipLevel = p_dst_mipmap;
+	dst_view_desc.baseArrayLayer = p_dst_layer;
+
+	WGPUTextureView src_view = wgpuTextureCreateView(src_handle, &src_view_desc);
+	WGPUTextureView dst_view = wgpuTextureCreateView(dst_handle, &dst_view_desc);
+	if (!src_view || !dst_view) {
+		if (src_view) {
+			wgpuTextureViewRelease(src_view);
+		}
+		if (dst_view) {
+			wgpuTextureViewRelease(dst_view);
+		}
+		ERR_FAIL_MSG("WebGPU: failed to create color resolve views.");
+	}
