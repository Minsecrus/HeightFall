+	WGCommandBuffer *cmd = (WGCommandBuffer *)(p_cmd_buffer.id);
+	WGTexture *src = (WGTexture *)(p_src_texture.id);
+	WGTexture *dst = (WGTexture *)(p_dst_texture.id);
+	ERR_FAIL_NULL(cmd);
+	ERR_FAIL_NULL(src);
+	ERR_FAIL_NULL(dst);
+	ERR_FAIL_NULL(cmd->encoder);
+	ERR_FAIL_COND_MSG(src->sample_count <= 1 || dst->sample_count != 1,
+			"WebGPU: color resolve requires a multisampled source and single-sampled destination.");
+	ERR_FAIL_COND_MSG(src->format != dst->format || _is_depth_format(src->format) || src->format == WGPUTextureFormat_Stencil8,
+			"WebGPU: color resolve requires matching color formats.");
+	ERR_FAIL_COND_MSG(!(src->usage & WGPUTextureUsage_RenderAttachment) || !(dst->usage & WGPUTextureUsage_RenderAttachment),
+			"WebGPU: color resolve textures require RenderAttachment usage.");
+
+	WGPUTexture src_handle = src->gpu_handle();
+	WGPUTexture dst_handle = dst->gpu_handle();
+	ERR_FAIL_NULL(src_handle);
+	ERR_FAIL_NULL(dst_handle);
+	ERR_FAIL_COND_MSG(p_src_mipmap >= wgpuTextureGetMipLevelCount(src_handle) || p_dst_mipmap >= wgpuTextureGetMipLevelCount(dst_handle) ||
+			p_src_layer >= wgpuTextureGetDepthOrArrayLayers(src_handle) || p_dst_layer >= wgpuTextureGetDepthOrArrayLayers(dst_handle),
+			"WebGPU: color resolve subresource is outside the texture.");
+	ERR_FAIL_COND_MSG(MAX(1u, wgpuTextureGetWidth(src_handle) >> p_src_mipmap) != MAX(1u, wgpuTextureGetWidth(dst_handle) >> p_dst_mipmap) ||
+			MAX(1u, wgpuTextureGetHeight(src_handle) >> p_src_mipmap) != MAX(1u, wgpuTextureGetHeight(dst_handle) >> p_dst_mipmap),
+			"WebGPU: color resolve source and destination extents must match.");
