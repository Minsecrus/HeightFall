+// Keep attachment views intact: sampled depth/stencil views must expose only
+// depth, with the aspect-specific format selected by WebGPU. Uniform sets own
+// these views, including views of shared textures and absolute mip/layer slices.
+// https://gpuweb.github.io/gpuweb/#dom-gputexture-createview
+static WGPUTextureView _get_sampled_texture_view(WGTexture *p_texture, WGUniformSet *p_uniform_set, WGPUTextureViewDimension p_dimension = WGPUTextureViewDimension_Undefined) {
+	ERR_FAIL_NULL_V(p_texture, nullptr);
+	ERR_FAIL_NULL_V(p_uniform_set, nullptr);
+	const bool is_depth = _is_depth_format(p_texture->format);
+	const WGPUTextureViewDimension dimension = p_dimension == WGPUTextureViewDimension_Undefined ? p_texture->view_dimension : p_dimension;
+	if (!is_depth && dimension == p_texture->view_dimension) {
+		return p_texture->default_view;
+	}
+	WGPUTexture texture = p_texture->gpu_handle();
+	ERR_FAIL_NULL_V(texture, nullptr);
+	WGPUTextureViewDescriptor vd = {};
+	// Explicit combined depth/stencil formats are invalid with DepthOnly.
+	vd.format = is_depth ? WGPUTextureFormat_Undefined : p_texture->format;
+	vd.dimension = dimension;
+	vd.baseMipLevel = p_texture->base_mipmap;
+	vd.mipLevelCount = p_texture->mipmaps;
+	vd.baseArrayLayer = p_texture->base_layer;
+	vd.arrayLayerCount = dimension == WGPUTextureViewDimension_2D ? 1 : p_texture->layers;
+	vd.aspect = is_depth ? WGPUTextureAspect_DepthOnly : WGPUTextureAspect_All;
+	WGPUTextureView view = wgpuTextureCreateView(texture, &vd);
+	ERR_FAIL_NULL_V_MSG(view, nullptr, "WebGPU: failed to create sampled texture view.");
+	p_uniform_set->temp_views.push_back(view);
+	return view;
+}
