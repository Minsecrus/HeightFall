+// Emdawn Release drops an API handle, leaving its JS object to garbage collection.
+// JS GC does not account for allocations in the GPU process. Explicitly destroy
+// resources when Godot retires them so their storage can be reclaimed once all
+// previously submitted operations finish, without waiting for a JS collection.
+// Only use these helpers for owned resources; views and surface textures borrow
+// their backing allocation and must keep their ordinary Release semantics.
+static void _destroy_and_release_buffer(WGPUBuffer p_buffer) {
+	if (p_buffer) {
+		wgpuBufferDestroy(p_buffer);
+		wgpuBufferRelease(p_buffer);
+	}
+}
+
+static void _destroy_and_release_texture(WGPUTexture p_texture) {
+	if (p_texture) {
+		wgpuTextureDestroy(p_texture);
+		wgpuTextureRelease(p_texture);
+	}
+}
